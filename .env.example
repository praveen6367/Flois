# ─────────────────────────────────────────────────────────────────────────────
# FLOIS Headless Shopify — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
#
# Where to get these values:
#   Shopify Admin → Apps → Develop Apps → Your App → API credentials
# ─────────────────────────────────────────────────────────────────────────────

# Your Shopify store's myshopify domain (without https://)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token (public — safe for client-side)
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token_here

# Shopify API version — update periodically as Shopify releases new versions
NEXT_PUBLIC_SHOPIFY_API_VERSION=2024-07

# ─── Optional: Customer Account API (for login/account pages) ────────────────
# Shopify Admin → Customers → Customer accounts → Configure
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_URL=
